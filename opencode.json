  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "oauthProxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenAI OAuth Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:8788/v1",
        "apiKey": "proxy"
